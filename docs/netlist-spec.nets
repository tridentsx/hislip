NRFD_T: U1.19 U4.16
ATN_B:  U4.8 J1.11 TP_ATN1.1
SRQ_B:  U4.9 J1.10 TP_SRQ1.1
REN_B:  U4.2 J1.17
IFC_B:  U4.3 J1.9 TP_IFC1.1
EOI_B:  U4.7 J1.5
DAV_B:  U4.6 J1.6 TP_DAV1.1
NDAC_B: U4.4 J1.8 TP_NDAC1.1
NRFD_B: U4.5 J1.7 TP_NRFD1.1

# ---- USB, config, spare, shield ----
USB_DP: U1.52 J3.A6 J3.B6
USB_DM: U1.51 J3.A7 J3.B7
CC1:    J3.A5 R_CC1.a
CC2:    J3.B5 R_CC2.a
CFG:    U1.42 R_CFG1.b
TP_SPARE: U1.34 TP_GPIO221.1
