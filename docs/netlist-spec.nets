# ---- power and gate nets ----
# USB-C alternative power source (design-spec 30.1): J4 1x3 jumper selects the
# source of the system rail. +5V_POE (M1's isolated output) on pin 1, +5V_SYS
# (everything downstream) on the common pin 2, VBUS (USB-C) on pin 3. Jumper
# 1-2 = PoE, 2-3 = USB. A jumper not a diode-OR: a Schottky drop would put
# +5V_SYS below the SN75160B/161B 4.75 V minimum. R_G1/C_G1 stay with Q1's
# source on +5V_SYS (R-HW-020): the gate pull-up must reference the rail its
# own source sits on, or Q1 turns on with IOVDD absent in USB mode.
+5V_POE:  M1.1 J4.1
+5V_SYS:  J4.2 U5.3 Q1.2 R_G1.a C_G1.1 C_BULK1.1 C_LDOin1.1 TP_5V1.1
VBUS:     J4.3 J3.A4B9 J3.B4A9
+3V3:     U5.2 U5.4 U1.1 U1.11 U1.20 U1.30 U1.38 U1.45 U1.44 U1.46 U1.53 U1.54 U1.49 U2.28 U6.3 R_DC1.a R_ATN1.a R_REN1.a R_IFC1.a R_SRQ1.a R_CFG1.a R_RUN1.a C_3V3.1 C_LDOout1.1 U2.43 U2.44 U2.45 C_ETHbulk1.1 C_VDD1.1 R_RSTP1.a R_INTP1.a L2.1 R_LEDL1.a R_LEDR1.a C6.1 TP_3V3.1
+5V_XCVR: Q1.3 U3.20 U4.20 R_PE1.a C_U3a1.1 C_U4a1.1 C_U3b1.1 C_U4b1.1
GATE:     Q1.1 R_G1.b C_G1.2 Q2.3
PG_3V3:   U6.2 Q2.1 R_G2.a
GND:      U1.47 U1.61 U2.3 U2.9 U2.14 U2.16 U2.19 U2.48 U3.10 U4.10 U5.1 U6.1 Q2.2 M1.2 RSET1.b R_TE1.b R_G2.b R_CC1.b R_CC2.b R_SH1.b C_SH1.b C_BULK1.2 C_3V3.2 C_LDOin1.2 C_LDOout1.2 C_U3a1.2 C_U4a1.2 C_U3b1.2 C_U4b1.2 C_X1a1.2 C_X1b1.2 LED1.2 J3.A1B12 J3.B1A12 J3.1 J3.2 J3.3 J3.4 U2.23 U2.29 C_ETHa1.2 C_ETHb1.2 C_ETHc1.2 C_ETHd1.2 C_ETHbulk1.2 C_VDD1.2 C_BIAS1.2 C_RCT1.2 C_X2a1.2 C_X2b1.2 RSET1.2 C_TOCAP1.2 C_1V2O1.2 J2.15 J2.16 C6.2 C7.2 J1.18 J1.19 J1.20 J1.21 J1.22 J1.23 J1.24 TP_GND1.1 H1.1 H2.1

# ---- PoE input: cable-side taps -> external bridges -> PD module ----
# The DP9900LPB takes a pre-rectified input (VIN+/VIN-), so the two bridges are
# ours. Bridge AC inputs are polarity-insensitive, so which tap lands on pin 1
# vs 2 does not matter. J2's VC1±/VC2± (pins 7-10) are the CABLE-SIDE taps; the
# combined PHY-side centre tap P3 must never touch the PoE feed. Which VC belongs to which RJ45
# pair is unproven: each bridge must see the two taps of ONE Alternative, so the
# grouping below awaits the ring-out in netlist-spec.md 4.4 item 3.
POE_TAP_A1: J2.7 D_BR1.1
POE_TAP_A2: J2.8 D_BR1.2
POE_TAP_B1: J2.9 D_BR2.1
POE_TAP_B2: J2.10 D_BR2.2
POE_VIN_P:  D_BR1.3 D_BR2.3 M1.4
POE_VIN_N:  D_BR1.4 D_BR2.4 M1.5



# ---- W5500 analogue rail + magnetics bias (WIZnet W5500-EVB-Pico2 V1.0) ----
# 3V3 is filtered to 3V3A through ferrite L2; every AVDD pin and the magnetics
# bias sit on 3V3A, VDD stays on the unfiltered rail.
3V3A:        L2.2 U2.4 U2.8 U2.11 U2.15 U2.17 U2.21 R_B1.a C_ETHa1.1 C_ETHb1.1 C_ETHc1.1 C_ETHd1.1
ETH_BIAS:    R_B1.b C_BIAS1.1 R_T1.a R_T2.a R_T3.a R_T4.a
ETH_TXN_W:   U2.1 R_TX1.a R_T1.b
ETH_TXP_W:   U2.2 R_TX2.a R_T2.b
ETH_RXN_W:   U2.5 R_RX1.a R_T3.b
ETH_RXP_W:   U2.6 R_RX2.a R_T4.b
# PHY-side centre tap. The HR871150C ties both pairs' PHY-side taps together and
# brings out ONE combined tap (P3), AC-grounded via C_RCT1. The other pair's tap
# (former pin 6) is internal to the jack, so there is no separate ETH_TCT net.
ETH_RCT:     J2.3 C_RCT1.1

# ---- Ethernet sheet local nets (netlist-spec.md 5.6), W5500 ds v1.1.0 ----
ETH_XI:      U2.30 X2.1 C_X2a1.1 R_XF1.a
ETH_XO:      U2.31 X2.2 C_X2b1.1 R_XF1.b
ETH_EXRES:   U2.10 RSET1.a
ETH_TOCAP:   U2.20 C_TOCAP1.1
ETH_1V2O:    U2.22 C_1V2O1.1
ETH_TXP:     R_TX2.b J2.1
ETH_TXN:     R_TX1.b J2.2
ETH_RXP:     R_RX2.b J2.4
ETH_RXN:     R_RX1.b J2.5
ETH_LINKLED: U2.25 J2.12
ETH_ACTLED:  U2.27 J2.14
ETH_LEDL_A:  R_LEDL1.b J2.11
ETH_LEDR_A:  R_LEDR1.b J2.13
# HR871150C pinout: TX pair = P1/P2 (RJ45 1/2), RX pair = P4/P5 (RJ45 3/6) per
# the datasheet; final +/- polarity within each pair is a ring-out item (4.4
# item 3), tolerated by the W5500's auto-MDIX and auto-polarity correction.

# ---- MCU support nets (netlist-spec.md 5.5) ----
DVDD:     U1.6 U1.23 U1.39 U1.50 C7.1 L1.2
VREG_LX:  U1.48 L1.1
RUN:      U1.26 R_RUN1.b
XIN:      U1.21 X1.1 C_X1a1.1
XOUT:     U1.22 X1.2 C_X1b1.1
LED_DRV:  U1.37 R_LED1.a
LED_A:    R_LED1.b LED1.1
SWCLK:    U1.24 TP_SWCLK1.1
SWDIO:    U1.25 TP_SWDIO1.1
ETH_MISO: U1.27 U2.34
ETH_CSn:  U1.28 U2.32
ETH_SCK:  U1.29 U2.33
ETH_MOSI: U1.31 U2.35
ETH_RSTn: U1.32 U2.37 R_RSTP1.b
ETH_INTn: U1.33 U2.36 R_INTP1.b

# ---- control nets ----
TE:  U1.40 U3.1 U4.1 R_TE1.a TP_TE1.1
DC:  U1.41 U4.11 R_DC1.b TP_DC1.1
PE:  U3.11 R_PE1.b

